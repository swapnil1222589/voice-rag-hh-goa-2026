# ── Voice RAG configuration ──────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to git — it contains secrets.

# ── Speech-to-Text ───────────────────────────────────────────────────
# Primary STT provider: "elevenlabs" or "sarvam"
STT_PROVIDER=elevenlabs

# ElevenLabs Scribe (default STT)
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# Sarvam Aasaar (alternative STT — Indic-optimised)
SARVAM_API_KEY=your_sarvam_key_here

# ── Answer Generation ────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini
GENERATION_TIMEOUT=30.0

# ── Vector DB ────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma_db
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ── Chunking ─────────────────────────────────────────────────────────
CHUNKING_STRATEGY=semantic    # fixed_size | recursive | semantic | metadata_aware
CHUNK_SIZE=400
CHUNK_OVERLAP=60
MIN_CHUNK_SIZE=50

# ── Retrieval ────────────────────────────────────────────────────────
TOP_K_VECTOR=15
TOP_K_BM25=15
TOP_K_FINAL=5
RERANK=true

# ── Guardrails ───────────────────────────────────────────────────────
MAX_QUERY_LENGTH=500
RELEVANCE_THRESHOLD=0.25

# ── Server ───────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── CORS / Frontend URL ──────────────────────────────────────────────
# Set to your deployed frontend URL in production (e.g. https://your-app.vercel.app)
# Leave empty for local dev (all localhost origins are allowed by default)
FRONTEND_URL=

# ── Dataset ──────────────────────────────────────────────────────────
DATASET_NAME=ai4bharat/MSMARCO-XI
DATASET_LANGUAGES=hi,en        # comma-separated Indic codes; "en" loads English originals
INDEX_LANGUAGE=all             # "all" or a single language code
MAX_PASSAGES_PER_EXAMPLE=10
